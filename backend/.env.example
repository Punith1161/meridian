# MERIDIAN backend environment configuration
# This file is auto-generated on first run by setup.sh / setup.bat
# DO NOT commit this file to git — it contains your secret key

# Database — SQLite (default). To use PostgreSQL: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./meridian.db

# Secret key for JWT signing — auto-generated on first run (64 hex chars)
# If you change this, all existing sessions will be invalidated
SECRET_KEY=PLACEHOLDER_REPLACED_BY_SETUP_SCRIPT

# Frontend origin(s) allowed by CORS — comma-separated for multiple
# In Electron mode this should match the vite dev server or electron:// 
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
